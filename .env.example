# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=tu-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-11

# Base URL (para producción, usar tu dominio)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Sanity API Token (con permisos de escritura)
# Obtenerlo desde: https://www.sanity.io/manage
SANITY_API_TOKEN=tu-token-con-permisos-de-escritura
